mac_init_brew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"
export PATH="$mac_init_brew_prefix/opt/rustup/bin:$HOME/.cargo/bin:$HOME/go/bin:$PATH"
export GOPROXY="https://goproxy.cn,direct"

if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
fi

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

mac_init_autosuggestions="$mac_init_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
if [[ -r "$mac_init_autosuggestions" ]]; then
  source "$mac_init_autosuggestions"
fi

unset mac_init_autosuggestions mac_init_brew_prefix
